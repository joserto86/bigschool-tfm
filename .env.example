NODE_ENV=development
PORT=3000
ACCESS_TOKEN_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000
JWT_ISSUER=satispadel-api
JWT_AUDIENCE=satispadel-client
JWT_SECRET=development-secret-change-me-in-production

MIN_PASSWORD_LENGTH=8;
MAX_PASSWORD_LENGTH=128;

PASSWORD_KEY_LENGTH=64;
PASSWORD_SALT_LENGTH=16;

# PostgreSQL (docker compose) — development defaults only, never use in production
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
# Uncomment to enable PostgreSQL persistence in local development:
DATABASE_URL=